# ==============================================================================
# SIGE · Sistema Integral de Gestión Escolar (Escuela Secundaria Mixta 5)
# Configuración de Variables de Entorno del Backend Django
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=sige-super-secret-dev-key-change-in-production-2026-secundaria5
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# ------------------------------------------------------------------------------
# 1. Base de Datos (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Obtener desde: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Modo Transaction Pooler (recomendado para web, puerto 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Modo Direct Connection (para migraciones iniciales, puerto 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres

# (Si no se especifica DATABASE_URL ni DB_NAME, Django utilizará automáticamente db.sqlite3 local)

# ------------------------------------------------------------------------------
# 2. Almacenamiento en la Nube (Supabase Storage / S3 Compatible)
# ------------------------------------------------------------------------------
# Activar para almacenar fotografías de alumnos y credenciales en Supabase Storage
USE_SUPABASE_STORAGE=False

# Credenciales de S3 API en Supabase:
# Obtener desde: Supabase Dashboard -> Project Settings -> Storage -> S3 Connection
# SUPABASE_STORAGE_ACCESS_KEY_ID=tu_access_key_id
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=tu_secret_access_key
# SUPABASE_STORAGE_BUCKET_NAME=sige-media
# SUPABASE_STORAGE_S3_ENDPOINT=https://[PROJECT_REF].supabase.co/storage/v1/s3
# SUPABASE_STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 3. CORS (Interconexión con Next.js PWA / Frontend Web)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
