# ==============================================================================
# SIGE · Sistema Integral de Gestión Escolar (Escuela Secundaria Mixta 5)
# Configuración de Variables de Entorno del Backend Django
# ==============================================================================

# Django Settings
DEBUG=True
SECRET_KEY=sige-super-secret-dev-key-change-in-production-2026-secundaria5
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# ------------------------------------------------------------------------------
# Conexión a Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# Opción 1 (Recomendada para Desarrollo Colaborativo en Supabase):
# Copiar desde Supabase: Project Settings -> Database -> Connection String -> URI (Modo Session o Transaction Pooler)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Opción 2 (Servidor Local LAN / Docker para Producción Escolar):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sige_secundaria5_db
# DB_USER=sige_admin
# DB_PASSWORD=tu_password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# (Si no se especifica DATABASE_URL ni DB_NAME, Django utilizará automáticamente db.sqlite3 para desarrollo aislado)

# ------------------------------------------------------------------------------
# CORS (Interconexión con Next.js PWA / Frontend Web)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
