        <mxCell id="R6_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;arcSize=20;fontSize=11;" value="FIN Consulta entregada según los permisos del rol" vertex="1">
