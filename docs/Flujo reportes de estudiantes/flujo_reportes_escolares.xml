        <mxCell id="R6_2a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Docente: mostrar únicamente los reportes registrados por ese mismo docente (RN-REP-05)" vertex="1">
